{
  "manifest_version": 3,
  "name": "PhyrexNi · 美联储英语直播译文（测试版）",
  "version": "0.3.1",
  "description": "英语直播与回放译成中文，美联储术语、逐段复制、朗读和导出。需本机组件，使用自己的 ChatGPT、Grok 或 Gemini 账号。",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "@PhyrexNi · 打开英语直播译文"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src http://127.0.0.1:8878;"
  },
  "key": ""
}